NEXT_PUBLIC_ANALYTICS_URL="https://analytics.pavel-skudarnov.ru/api/track"
NEXT_PUBLIC_ANALYTICS_SITE="portfolio"

# Create a bot via @BotFather, then keep its token only in your deployment secrets.
TELEGRAM_BOT_TOKEN=

# The chat or group ID that should receive feedback messages.
TELEGRAM_CHAT_ID=

# A long random value shared only with nginx. Required in production to verify
# that requests come through the trusted proxy before applying the rate limit.
FEEDBACK_PROXY_TOKEN=
